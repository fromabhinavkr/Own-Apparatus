<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gamesGalleryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvGamesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Game Collection"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/tvGamesSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap a game to start playing instantly."
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <ScrollView
        android:id="@+id/scrollViewGames"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <!-- ID is required for the Landscape dynamic columns in Java -->
        <GridLayout
            android:id="@+id/gamesGridLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins">

            <!-- Snake Game Card -->
            <LinearLayout
                android:id="@+id/cardSnakeGame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_gallery_card"
                android:clipToOutline="true"
                android:layout_margin="8dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/gamesnake_preview" />

                <TextView
                    android:id="@+id/textSnakeGame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Play Snake"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- Flappy Bird Game Card -->
            <LinearLayout
                android:id="@+id/cardFlappyBird"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_gallery_card"
                android:clipToOutline="true"
                android:layout_margin="8dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/flappy_preview" />

                <TextView
                    android:id="@+id/textFlappyBird"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Play Flappy Bird"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- Tetris Game Card -->
            <LinearLayout
                android:id="@+id/cardTetris"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_gallery_card"
                android:clipToOutline="true"
                android:layout_margin="8dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tetris_preview" />

                <TextView
                    android:id="@+id/textTetris"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Play Tetris"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- Breakout Game Card -->
            <LinearLayout
                android:id="@+id/cardBreakout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_gallery_card"
                android:clipToOutline="true"
                android:layout_margin="8dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/breakout_preview" />

                <TextView
                    android:id="@+id/textBreakout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Play Breakout"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- Maze Ball Game Card -->
            <LinearLayout
                android:id="@+id/cardMazeBall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_gallery_card"
                android:clipToOutline="true"
                android:layout_margin="8dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/maze_game" />

                <TextView
                    android:id="@+id/textMazeBall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Play Maze Ball"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- Play My Planet Game Card -->
            <LinearLayout
                android:id="@+id/cardMyPlanet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_gallery_card"
                android:clipToOutline="true"
                android:layout_margin="8dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/myplanet_preview" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/textMyPlanet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Play My Planet"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnHelpMyPlanet"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:text="\?"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Thrive Game Card -->
            <LinearLayout
                android:id="@+id/cardThrive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_gallery_card"
                android:clipToOutline="true"
                android:layout_margin="8dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/imgThrive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/breakout_preview" />

                <TextView
                    android:id="@+id/textThrive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Play Rag Thrive"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- DriveOn Car Game Card -->
            <LinearLayout
                android:id="@+id/cardDriveOn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_gallery_card"
                android:clipToOutline="true"
                android:layout_margin="8dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/imgDriveOn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/driveonicon" />

                <TextView
                    android:id="@+id/textDriveOn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Play DriveOn"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="16dp" />
            </LinearLayout>

        </GridLayout>
    </ScrollView>
</LinearLayout>