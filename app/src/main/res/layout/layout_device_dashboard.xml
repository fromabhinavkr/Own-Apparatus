<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- TOP SECTION: LIVE RAM MONITOR CARD -->
    <RelativeLayout
        android:id="@+id/ramCardBg"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_ram_card"
        android:padding="16dp">

        <!-- LEFT SIDE: Clean Vertical Text Stack -->
        <LinearLayout
            android:id="@+id/ramTextStack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:orientation="vertical"
            android:minWidth="130dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">
                <TextView
                    android:id="@+id/tvRamPercentLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/tvRamPercentUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="2dp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRamTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAM Usage"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/ramDetailsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvRamUsedLbl"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:text="Used"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvRamUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 MB"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvRamFreeLbl"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:text="Free"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvRamFree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 MB"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvRamTotalLbl"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvRamTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 MB"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT SIDE: Graph View -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/ramTextStack"
            android:layout_toRightOf="@id/ramTextStack"
            android:layout_marginStart="8dp">

            <com.abhinav.ownapp.RamGraphView
                android:id="@+id/ramGraphView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

    </RelativeLayout>

    <!-- BOTTOM SECTION: STORAGE & BATTERY SEPARATED CARDS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="2">

        <!-- STORAGE CARD (Text on Left, Wider Vertical Wave Tank on Right) -->
        <LinearLayout
            android:id="@+id/storageCardBg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="16dp"
            android:background="@drawable/bg_storage_card"
            android:layout_marginEnd="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">
                    <TextView
                        android:id="@+id/tvStorageValueLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/tvStorageUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GB"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginStart="3dp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStorageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Storage Level"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvStorageStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Out of 0 GB"
                    android:textStyle="bold"
                    android:textSize="12.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="20dp" />
            </LinearLayout>

            <!-- Wider Vertical Wave Indicator on the Right Side -->
            <FrameLayout
                android:id="@+id/storageSegmentContainer"
                android:layout_width="54dp"
                android:layout_height="86dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- BATTERY CARD (Text on Left, Wider Vertical 5-Pill Block Box on Right) -->
        <LinearLayout
            android:id="@+id/batteryCardBg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="16dp"
            android:background="@drawable/bg_storage_card"
            android:layout_marginStart="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">
                    <TextView
                        android:id="@+id/tvBatteryValueLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/tvBatteryUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="2dp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBatteryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery Level"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvBatteryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textStyle="bold"
                    android:textSize="12.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="20dp" />
            </LinearLayout>

            <!-- Wider Vertical 5-Pill Battery Indicator on the Right Side -->
            <FrameLayout
                android:id="@+id/batterySegmentContainer"
                android:layout_width="54dp"
                android:layout_height="86dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>