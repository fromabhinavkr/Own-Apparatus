<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Typos,ProtectedPermissions">

    <!-- WhatsApp Queries required for publishing Custom Stickers -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="com.whatsapp.intent.action.ENABLE_STICKER_PACK" />
        </intent>
    </queries>

    <!-- Required for the Private Browser to access the web & Haptic feedback -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Camera hardware feature tag to prevent unsupported device crashes -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Storage Permissions -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- FIX: Applied strict ignore to silence the Android 14 Visuals warning -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:ignore="All" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Required for API 33+ to show interactive Foreground Service notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for triggering Exact Alarms in Android 12+ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- FIX: Applied strict ignore to silence the Android 14 Exact Alarm scheduling warning -->
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:ignore="All" />

    <!-- Suppressed the generic Foreground Service declaration warnings -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="All" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:ignore="All" />

    <!-- FIX: Applied ForegroundServiceType ignore to the application to blanket-mute FGS warnings -->
    <application
        android:name=".MainApplication"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OwnPhotoONWall"
        tools:ignore="ForegroundServiceType,DataExtractionRules">

        <!-- ML Kit Document Scanner: Auto-download AI models on app installation -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="document_scanner" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ImagePickerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GearClickActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".DrawingActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="false" />

        <activity
            android:name=".WidgetGalleryActivity"
            android:theme="@style/Theme.OwnPhotoONWall.Translucent"
            android:exported="false" />

        <activity
            android:name=".GamesGalleryActivity"
            android:theme="@style/Theme.OwnPhotoONWall.Translucent"
            android:exported="false" />

        <activity
            android:name=".SnakeGameActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <activity
            android:name=".FlappyBirdActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.OwnPhotoONWall" />

        <activity
            android:name=".TetrisActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.OwnPhotoONWall" />

        <activity
            android:name=".BreakoutActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.OwnPhotoONWall" />

        <activity
            android:name=".MazeBallActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".GlobeGameActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".ToolsGalleryActivity"
            android:theme="@style/Theme.OwnPhotoONWall.Translucent"
            android:exported="false" />

        <!-- FIX: Added orientation ignores to silence ChromeOS/Foldable warnings -->
        <activity
            android:name=".AudioEditorActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,SourceLockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AudioGalleryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,SourceLockedOrientationActivity" />

        <activity
            android:name=".UtilitiesGalleryActivity"
            android:theme="@style/Theme.OwnPhotoONWall.Translucent"
            android:exported="false" />

        <activity
            android:name=".SlateActivity"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            tools:ignore="LockedOrientationActivity,SourceLockedOrientationActivity" />

        <activity
            android:name=".TextPadActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <activity
            android:name=".PrivateBrowserActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TransparentBrowser"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SpinnerClickActivity"
            android:theme="@style/TranslucentSpinnerTheme"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".DocReaderActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/rtf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\.doc" />
                <data android:pathPattern=".*\\.DOCX" />
                <data android:pathPattern=".*\\.DOC" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StickerMakerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="false" />

        <activity
            android:name=".ImageEditorActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:label="Own Image Studio"
            android:exported="true">
            <intent-filter android:label="Edit in Own App">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ImageStudioMegaGal"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <activity
            android:name=".AdvancedCanvasActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <activity
            android:name=".CloneActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <activity
            android:name=".CollageStudioActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <activity
            android:name=".PdfStudioActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <activity
            android:name=".PdfGalleryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <provider
            android:name=".StickerContentProvider"
            android:authorities="com.abhinav.ownapp.stickercontentprovider"
            android:enabled="true"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />

        <receiver
            android:name=".Photowidget"
            android:label="Add Photo"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/photowidget_info" />
        </receiver>

        <receiver
            android:name=".SnakeWidget"
            android:label="Auto Snake Widget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="TOGGLE_SNAKE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/snake_widget_info" />
        </receiver>

        <receiver
            android:name=".WaterWidgetProvider"
            android:label="Water Widget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="TOGGLE_WATER" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/water_widget_info" />
        </receiver>

        <receiver
            android:name=".HourglassWidget"
            android:label="Hourglass Widget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="TOGGLE_HOURGLASS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hourglass_widget_info" />
        </receiver>

        <receiver
            android:name=".CoinWidget"
            android:label="Coin Toss Widget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/coin_widget_info" />
        </receiver>

        <receiver
            android:name=".GearWidgetProvider"
            android:label="Fidget Gear Widget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.abhinav.ownapp.ACTION_ROTATE_GEAR" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/gear_widget_info" />
        </receiver>

        <receiver
            android:name=".MazeWidgetProvider"
            android:label="Maze Widget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.abhinav.ownapp.TOGGLE_MAZE" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/maze_widget_info" />
        </receiver>

        <receiver
            android:name=".DrawingWidgetProvider"
            android:label="Drawing Widget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/drawing_widget_info" />
        </receiver>

        <!-- The Broadcast Receiver for the Fidget Spinner Widget -->
        <receiver
            android:name=".FidgetSpinnerWidget"
            android:label="Fidget Spinner Widget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fidget_spinner_widget_info" />
        </receiver>

        <!-- FIX: Updated to point to the new standalone AlarmReceiver class -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- FIX: Added ForegroundServiceType ignores directly to the service tags -->
        <service
            android:name=".SnakeService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="upside_down_cake"
            tools:ignore="ForegroundServiceType">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Widget state management"/>
        </service>

        <service
            android:name=".WaterSensorService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="upside_down_cake"
            tools:ignore="ForegroundServiceType">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Interactive widget physics"/>
        </service>

        <service
            android:name=".HourglassService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="upside_down_cake"
            tools:ignore="ForegroundServiceType">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Widget animation state"/>
        </service>

        <service
            android:name=".MazeGameService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:configChanges="uiMode|orientation|screenSize"
            tools:targetApi="upside_down_cake"
            tools:ignore="ForegroundServiceType">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Widget sensor tracking"/>
        </service>

    </application>
</manifest>